{
  "name": "dtm",
  "author": "kcjerrell",
  "private": true,
  "version": "0.6.3",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "MOCK_TAURI=true vite",
    "dev:vite": "vite",
    "build": "vite build",
    "build:mac": "dotenv -- tauri build",
    "build:universal": "dotenv -- tauri build --target universal-apple-darwin",
    "build:debug": "dotenv -- tauri build --debug",
    "build:e2e": "dotenv -- tauri build --debug --no-bundle --config src-tauri/tauri.e2e.conf.json",
    "clean:vite": "rm --recursive node_modules/.vite & rm --recursive  node_modules/.vite-temp",
    "preview": "vite preview",
    "tauri": "dotenv -- tauri",
    "gen-icons": "tauri icon ./app-icon.png",
    "generate:entities": "dotenv -e .env -- sh -c 'sea-orm-cli generate entity --database-url \"$DB_URL\" --ignore-tables images_fts,images_fts_data,images_fts_docsize,images_fts_idx,images_fts_config,images_fts_content --output-dir src-tauri/entity/src --with-serde serialize --entity-format dense'",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "update-fbs": "./scripts/update-fbs.sh",
    "version": "tsx ./scripts/version.ts",
    "wdio": "node ./scripts/wdio.mjs"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.38.0",
    "@emotion/react": "^11.14.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "~2.5.0",
    "@tauri-apps/plugin-dialog": "~2.8.4",
    "@tauri-apps/plugin-fs": "~2.7.1",
    "@tauri-apps/plugin-log": "~2.10.2",
    "@tauri-apps/plugin-opener": "~2.7.3",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-shell": "~2.6.0",
    "@tauri-apps/plugin-store": "^2.5.1",
    "@tauri-apps/plugin-updater": "~2.14.1",
    "@tauri-apps/plugin-window-state": "~2.5.0",
    "@tauri-store/valtio": "^3.3.1",
    "@uiw/react-json-view": "^2.0.0-alpha.44",
    "ahooks": "^3.11.0",
    "async-mutex": "^0.5.0",
    "derive-valtio": "^0.2.0",
    "eventemitter3": "^5.0.4",
    "exifr": "github:m-hayabusa/exifr#2cf6c14fcd8eab52a7a7de53af7fdb01a4a9f90f",
    "exifreader": "^4.54.0",
    "motion": "^13.5.1",
    "nanoid": "^6.0.2",
    "next-themes": "^0.4.6",
    "plist": "^5.1.1",
    "quick-lru": "^7.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hotkeys-hook": "^5.4.0",
    "react-icons": "^5.7.0",
    "tauri-plugin-fs-watch-api": "https://github.com/tauri-apps/tauri-plugin-fs-watch#v1",
    "valtio": "^2.3.2",
    "valtio-reactive": "^0.2.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@biomejs/biome": "2.5.12",
    "@chakra-ui/cli": "^3.38.0",
    "@octokit/rest": "^22.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/chance": "^1.1.8",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/plist": "^3.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/concise-reporter": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/json-reporter": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-plugin": "^1.5.1",
    "@wdio/tauri-service": "^1.5.1",
    "@wdio/types": "^9.31.1",
    "@wdio/visual-service": "^10.2.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "chance": "^1.1.13",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.1.0",
    "expect-webdriverio": "^6.1.0",
    "fs-extra": "^11.4.1",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "react-redux": "^9.3.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "tscanner": "^0.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-html-injection": "^1.5.2",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.12",
    "wdio-wait-for": "^3.1.1"
  }
}
