{
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "@wdio/globals/types",
      "@wdio/mocha-framework",
      "@wdio/tauri-service",
      "@wdio/tauri-plugin"
    ]
  },
  "include": [
    "test/**/*.ts",
    "test/global.d.ts"
  ]
}
